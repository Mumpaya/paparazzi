# Makefile for AF_8_V2_Improved standalone CV pipeline tests
# Run from the paparazzi root:  make -f sw/airborne/modules/AF_8_V2_Improved/Makefile.test

MODULE_DIR := sw/airborne/modules/AF_8_V2_Improved

CXX      := g++
CXXFLAGS := -std=c++17 -O2 -Wall \
            -I$(MODULE_DIR) \
            $(shell pkg-config --cflags opencv4)
LDFLAGS  := $(shell pkg-config --libs opencv4)

# Common detector sources
DETECTORS := \
    $(MODULE_DIR)/ground_edge_node.cpp \
    $(MODULE_DIR)/bottom_cam_node.cpp \
    $(MODULE_DIR)/obstacle_detector_node.cpp \
    $(MODULE_DIR)/gate_detector_node.cpp \
    $(MODULE_DIR)/controller.cpp

# Main test visualiser (4 panels)
SRCS_VISUALISER := $(DETECTORS) $(MODULE_DIR)/test_visualiser.cpp
TARGET_VISUALISER := $(MODULE_DIR)/test_visualiser

# Real detector output video visualizer
SRCS_VIDEO_VIZ := $(DETECTORS) $(MODULE_DIR)/video_visualizer.cpp
TARGET_VIDEO_VIZ := $(MODULE_DIR)/video_visualizer

# Bottom camera specific test
SRCS_BOTTOM_CAM := $(MODULE_DIR)/bottom_cam_node.cpp $(MODULE_DIR)/test_bottom_cam_node.cpp
TARGET_BOTTOM_CAM := $(MODULE_DIR)/test_bottom_cam_node

.PHONY: all run run_video_viz run_bottom_cam clean

all: $(TARGET_VISUALISER) $(TARGET_VIDEO_VIZ) $(TARGET_BOTTOM_CAM)

$(TARGET_VISUALISER): $(SRCS_VISUALISER)
	$(CXX) $(CXXFLAGS) $^ -o $@ $(LDFLAGS)
	@echo "Build OK → $(TARGET_VISUALISER)"

$(TARGET_VIDEO_VIZ): $(SRCS_VIDEO_VIZ)
	$(CXX) $(CXXFLAGS) $^ -o $@ $(LDFLAGS)
	@echo "Build OK → $(TARGET_VIDEO_VIZ)"

$(TARGET_BOTTOM_CAM): $(SRCS_BOTTOM_CAM)
	$(CXX) $(CXXFLAGS) $^ -o $@ $(LDFLAGS)
	@echo "Build OK → $(TARGET_BOTTOM_CAM)"

run: $(TARGET_VISUALISER)
	./$(TARGET_VISUALISER) $(MODULE_DIR)/Playground

run_video_viz: $(TARGET_VIDEO_VIZ)
	./$(TARGET_VIDEO_VIZ) $(MODULE_DIR)/Playground

run_bottom_cam: $(TARGET_BOTTOM_CAM)
	./$(TARGET_BOTTOM_CAM) $(MODULE_DIR)/Playground_Bottom/20260313-105015

clean:
	rm -f $(TARGET_VISUALISER) $(TARGET_VIDEO_VIZ) $(TARGET_BOTTOM_CAM)
