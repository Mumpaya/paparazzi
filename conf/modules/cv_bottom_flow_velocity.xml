<?xml version="1.0"?>
<!DOCTYPE module SYSTEM "module.dtd">

<module name="cv_bottom_flow_velocity" dir="computer_vision">
  <doc>
    <description>
      Estimate planar velocity from bottom camera optical-flow-like frame differencing.
      Results are exported through extern variables in cv_bottom_flow_velocity_state.
    </description>

    <define name="CV_BOTTOM_FLOW_VELOCITY_CAMERA" value="bottom_camera|front_camera" description="Video device to use"/>
    <define name="CV_BOTTOM_FLOW_VELOCITY_FPS" value="0" description="Desired FPS (0: camera rate)"/>

    <define name="CV_BFV_ALTITUDE_M" value="1.25" description="Assumed altitude above ground in meters for pixel-to-meter scaling"/>
    <define name="CV_BFV_FOV_DEG" value="42.0" description="Camera horizontal field of view in degrees"/>
    <define name="CV_BFV_IMG_WIDTH_REF" value="240" description="Reference image width used for scaling (0 uses runtime image width)"/>
    <define name="CV_BFV_MIN_POINTS" value="12" description="Minimum tracked points required for a valid velocity estimate"/>
    <define name="CV_BFV_MAX_FLOW_PX" value="20.0" description="Maximum accepted flow magnitude in pixels before rejecting estimate"/>
    <define name="CV_BFV_DRAW" value="FALSE|TRUE" description="Whether or not to draw detections on image"/>
  </doc>

  <settings>
    <dl_settings>
      <dl_settings name="BottomFlowVelocity">
        <dl_setting var="cv_bfv_altitude_m" min="0.10" step="0.01" max="10.0" shortname="alt_m"/>
        <dl_setting var="cv_bfv_fov_deg" min="1.0" step="0.1" max="179.0" shortname="fov_deg"/>
        <dl_setting var="cv_bfv_img_width_ref" min="0" step="1" max="4096" shortname="w_ref"/>
        <dl_setting var="cv_bfv_min_points" min="1" step="1" max="255" shortname="min_pts"/>
        <dl_setting var="cv_bfv_max_flow_px" min="0.1" step="0.1" max="500.0" shortname="max_px"/>
        <dl_setting var="cv_bfv_draw" min="0" step="1" max="1" values="False|True" shortname="draw"/>
      </dl_settings>
    </dl_settings>
  </settings>

  <dep>
    <depends>video_thread</depends>
  </dep>

  <header>
    <file name="cv_bottom_flow_velocity.h"/>
  </header>

  <init fun="cv_bottom_flow_velocity_init()"/>
  <periodic fun="cv_bottom_flow_velocity_periodic()" freq="20"/>

  <makefile target="nps">
    <file name="cv_bottom_flow_velocity.cpp"/>
    <include name="/usr/include/opencv4"/>
    <flag name="LDFLAGS" value="lopencv_core"/>
    <flag name="LDFLAGS" value="lopencv_imgproc"/>
    <flag name="LDFLAGS" value="lopencv_video"/>
    <flag name="LDFLAGS" value="lopencv_features2d"/>
  </makefile>
  <makefile target="ap">
    <file name="cv_bottom_flow_velocity.cpp"/>
    <flag name="CXXFLAGS" value="I$(PAPARAZZI_SRC)/sw/ext/opencv_bebop/install_arm/include/opencv4"/>
    <flag name="LDFLAGS" value="L$(PAPARAZZI_HOME)/sw/ext/opencv_bebop/install_arm/lib"/>
    <flag name="LDFLAGS" value="lopencv_world"/>
    <flag name="LDFLAGS" value="L$(PAPARAZZI_HOME)/sw/ext/opencv_bebop/install_arm/lib/opencv4/3rdparty"/>
    <flag name="LDFLAGS" value="llibprotobuf"/>
    <flag name="LDFLAGS" value="llibjpeg-turbo"/>
    <flag name="LDFLAGS" value="llibpng"/>
    <flag name="LDFLAGS" value="llibtiff"/>
    <flag name="LDFLAGS" value="llibopenjp2"/>
    <flag name="LDFLAGS" value="lzlib"/>
    <flag name="LDFLAGS" value="lade"/>
    <flag name="LDFLAGS" value="ldl"/>
    <flag name="LDFLAGS" value="lm"/>
    <flag name="LDFLAGS" value="lpthread"/>
    <flag name="LDFLAGS" value="lrt"/>
  </makefile>
</module>


