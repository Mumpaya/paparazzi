<!DOCTYPE module SYSTEM "module.dtd">
<module name="controller" dir="AF_8_V1">
  <doc>
    <description>
      Main Flight Controller (C++). 
      Prioritizes Pole Avoidance (ID 1) over Gate Tracking (ID 2).
    </description>
  </doc>

  <settings>
    <dl_settings>
      <dl_settings name="Control">
        <dl_setting var="max_speed" min="0" step="0.1" max="2.0" shortname="speed"/>
        <dl_setting var="danger_threshold" min="500" step="500" max="20000" shortname="pole_dist"/>
      </dl_settings>
    </dl_settings>
  </settings>

  <header>
    <file name="controller.h"/>
  </header>

  <init fun="controller_init()"/>
  <periodic fun="controller_periodic()" freq="10"/>

  <makefile target="ap|nps">
    <file name="controller.cpp"/>
    <configure name="CXXFLAGS" value="-I/usr/include/opencv4"/>
  </makefile>
</module>