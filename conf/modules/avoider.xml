<!DOCTYPE module SYSTEM "module.dtd">

<module name="avoider" dir="our_orange_avoider">
  <doc>
    <description>
      Avoids orange poles using centroid position published by the pole_detector module.
      Runs in GUIDED flight mode. Steers away from the pole based on which side of the
      image the centroid falls on.
    </description>
    <define name="POLE_DETECTOR_ABI_ID" value="1" description="ABI sender ID to listen to (must match pole_detector)"/>
  </doc>

  <settings>
    <dl_settings>
      <dl_settings name="Avoider">
        <dl_setting var="max_speed"        min="0.0" step="0.05" max="1.0"  shortname="max_speed"/>
        <dl_setting var="heading_rate"     min="0.1" step="0.05" max="1.5"  shortname="heading_rate"/>
        <dl_setting var="center_threshold" min="0.0" step="0.01" max="0.5"  shortname="center_thr"/>
        <dl_setting var="danger_threshold" min="500" step="500" max="50000" shortname="danger_thr"/>
      </dl_settings>
    </dl_settings>
  </settings>

  <dep>
    <depends>pole_detector</depends>
  </dep>

  <header>
    <file name="avoider.h"/>
  </header>

  <init fun="avoider_init()"/>
  <periodic fun="avoider_periodic()" freq="10"/>

  <makefile target="ap|nps">
    <file name="avoider.c"/>
  </makefile>
</module>