<!DOCTYPE module SYSTEM "module.dtd">
<module name="test_module" dir="_test_module" task="default">
  <doc>
    <description>
      Edge-based floor avoider: uses OpenCV Canny edge detection on the bottom
      camera to detect non-floor areas (walls, nets, poles).  The smooth floor
      has few edges; obstacles produce many.  When edge density exceeds a
      threshold the drone turns away from the side with more edges.
      Runs in GUIDED mode.
    </description>
    <define name="EDGE_DETECTOR_CAMERA" value="bottom_camera" description="Camera device to use"/>
    <define name="EDGE_DETECTOR_FPS"    value="0"             description="Desired FPS (0 = camera rate)"/>
    <define name="EDGE_DETECTOR_ABI_ID" value="2"             description="ABI sender ID for VISUAL_DETECTION"/>
    <define name="EDGE_CANNY_LOW"  value="30" description="Canny low threshold"/>
    <define name="EDGE_CANNY_HIGH" value="90" description="Canny high threshold"/>
  </doc>

  <settings>
    <dl_settings>
      <dl_settings name="EdgeAvoider">
        <dl_setting var="green_max_speed"    min="0.0" step="0.05" max="1.5" shortname="max_speed"/>
        <dl_setting var="green_heading_rate" min="0.1" step="0.05" max="2.0" shortname="heading_rate"/>
        <dl_setting var="edge_threshold"     min="0.01" step="0.01" max="0.5" shortname="edge_thr"/>
      </dl_settings>
    </dl_settings>
  </settings>

  <dep>
    <depends>video_thread</depends>
  </dep>

  <header>
    <file name="test_module.h"/>
  </header>

  <init fun="init_func()"/>
  <periodic fun="periodic_func()" freq="10" autorun="TRUE"/>

  <makefile target="ap">
    <file name="test_module.c"/>
    <file name="edge_detector.cpp"/>
    <file_arch name="modules/computer_vision/opencv_image_functions.cpp"/>
    <flag name="CXXFLAGS" value="I$(PAPARAZZI_SRC)/sw/ext/opencv_bebop/install_arm/include/opencv4"/>
    <flag name="LDFLAGS" value="L$(PAPARAZZI_HOME)/sw/ext/opencv_bebop/install_arm/lib"/>
    <flag name="LDFLAGS" value="lopencv_world"/>
    <flag name="LDFLAGS" value="lpthread"/>
    <flag name="LDFLAGS" value="ldl"/>
    <flag name="LDFLAGS" value="lm"/>
    <flag name="LDFLAGS" value="lrt"/>
  </makefile>

  <makefile target="nps">
    <file name="test_module.c"/>
    <file name="edge_detector.cpp"/>
    <file_arch name="modules/computer_vision/opencv_image_functions.cpp"/>
    <flag name="CXXFLAGS" value="I/usr/include/opencv4"/>
    <flag name="LDFLAGS" value="lopencv_core"/>
    <flag name="LDFLAGS" value="lopencv_imgproc"/>
    <flag name="LDFLAGS" value="lpthread"/>
  </makefile>
</module>
